# Database Configuration (SQLite default for zero-config local run, or PostgreSQL)
DATABASE_URL=sqlite:///./maitri.db

# Authentication Keys (JWT Secret - min 32 chars)
SECRET_KEY=dev_secret_key_change_in_production_32chars_long_minimum
FIREBASE_API_KEY=your_firebase_api_key_here

# AI Engine / Pluggable Model Configuration
# To use your own model in the ai_engine/ directory, see ai_engine/README.md
SARVAM_API_KEY=your_sarvam_api_key_here
MAITRI_OPENROUTER_API_KEY=your_openrouter_api_key_here
MAITRI_HF_API_KEY=your_hf_api_key_here

# Telemetry / Terminal Configuration
SHOW_TOKEN_USAGE=true

